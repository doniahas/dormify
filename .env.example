# =====================================================================
# Dormify v3 - canonical local development environment template
# =====================================================================
# Copy this file to `.env` in the repository root (not inside backend/):
#
#     copy .env.example .env       # Windows
#     cp .env.example .env         # macOS/Linux
#
# `.env` is git-ignored, operator-owned, and must never be committed.
# Replace local values there; never put real secrets in this template.
#
# Scope
# -----
# This template is for processes started directly on the host. Docker
# Compose supplies literal runtime values to the backend and frontend
# containers; CI supplies its own isolated environment as well. Neither
# uses this template as an application env file.
#
# Environment precedence
# ----------------------
# settings.py uses python-dotenv without override=True. A value already
# exported in the current shell therefore wins over `.env`, with no
# warning. If Dormify connects somewhere unexpected, inspect and clear
# stale exported values before trusting the file, for example:
#
#     echo $env:DB_HOST            # PowerShell
#     Remove-Item Env:DB_HOST      # clear a stale value
#
# The local-database-only guard below remains the backstop: with it enabled,
# Django refuses any DB_HOST that is not explicitly recognised as local.
# =====================================================================

# ============================================================
# Django / local development
# ============================================================

# LOCAL DEVELOPMENT ONLY. When unset, DEBUG defaults to False.
DEBUG=True

# Local placeholder only. A deployment with DEBUG=False must supply a real,
# strong, unique secret through its deployment environment.
SECRET_KEY=your-secret-key-here

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# Local-database-only safety mode
# ============================================================
# Keep this enabled in development and test checkouts. It fails closed:
# missing, blank, and unrecognised values all leave protection enabled.
# Only an explicit False/0/no/off disables it for a managed deployment.
DORMIFY_LOCAL_DB_ONLY=True

# ============================================================
# v3 local development database
# ============================================================
# These values match docker-compose.yml's disposable `db` service, reached
# from host-run Django through its loopback-only published port. Start it with:
#
#     docker compose -p dormify-v3 up -d db
#
# A separately installed PostgreSQL server may require different credentials
# and port, but DB_HOST must remain a recognised local host in local-only mode.
DB_NAME=dormify_v3_dev
DB_USER=dormify_v3_dev
DB_PASSWORD=dormify_v3_local_dev_only
DB_HOST=localhost
DB_PORT=5434

# The stock local PostgreSQL container serves plaintext connections. Django
# otherwise defaults this setting to `require`, so keep it explicit locally.
DB_SSLMODE=disable

# ============================================================
# CORS
# ============================================================
# Host Vite and the Compose frontend both use port 3001.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ============================================================
# Frontend API configuration
# ============================================================
# Vite uses the repository root as envDir for host development. The shared
# Axios client reads only VITE_API_URL, which must include /api.
#
# This default targets a backend started directly on the host (port 8000).
# If host Vite should target the Compose-published backend, use instead:
#     VITE_API_URL=http://localhost:8001/api
# Compose supplies that port-8001 value to its own frontend container.
VITE_API_URL=http://localhost:8000/api

# ============================================================
# Seed script (backend/seed.py) - optional, development only
# ============================================================
# Leave these unset to generate random passwords that are printed once.
# Uncomment only when deliberate fixed local seed credentials are required.
# seed.py refuses to run unless DEBUG=True.
# SEED_ADMIN_PASSWORD=replace-with-a-local-only-password
# SEED_STAFF_PASSWORD=replace-with-a-local-only-password

# ============================================================
# Optional advanced variables (safe defaults already in code)
# ============================================================

# DRF throttle rates for auth-sensitive endpoints
# THROTTLE_AUTH_LOGIN=10/min
# THROTTLE_AUTH_SENSITIVE=10/min
# THROTTLE_STAFF_CREATE=20/min
# THROTTLE_AUTH_REFRESH=30/min
# THROTTLE_AUTH_LOGOUT=30/min

# JWT access/refresh token lifetimes (minutes) and refresh-cookie settings
# JWT_ACCESS_TOKEN_LIFETIME=20
# JWT_REFRESH_TOKEN_LIFETIME=10080
# JWT_REFRESH_COOKIE_NAME=dormify_refresh
# JWT_REFRESH_COOKIE_PATH=/api/auth/
# JWT_REFRESH_COOKIE_SAMESITE=Lax
# JWT_REFRESH_COOKIE_SECURE=False
# JWT_REFRESH_COOKIE_DOMAIN=

# Allocation solver / upload limits
# ALLOCATION_NUM_SEARCH_WORKERS=2
# MAX_UPLOAD_FILE_SIZE_MB=25

# Production hardening (only takes effect when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# DJANGO_BEHIND_HTTPS_PROXY=False

# ============================================================
# Durable allocation worker (python manage.py allocation_worker)
# ============================================================
# Background allocation runs are executed by a separate worker process that
# claims queued runs from PostgreSQL. The defaults below match
# backend/dormify/settings.py; uncomment to tune. The lease is renewed by the
# worker's heartbeat while a run executes; a run whose lease expired belongs to
# a lost worker and is recovered by any live worker.
# ALLOCATION_WORKER_POLL_INTERVAL_SECONDS=2
# ALLOCATION_WORKER_LEASE_SECONDS=300
# ALLOCATION_WORKER_HEARTBEAT_SECONDS=30
# ALLOCATION_WORKER_MAX_ATTEMPTS=3

# ============================================================
# Isolated local test environment (.env.test)
# ============================================================
# `.env.test` is a separate git-ignored file. Create it in the repository
# root with the complete block below, then select it from the shell with
# ENV_FILE=.env.test when running host-side backend tests. Do not merge these
# values into `.env`; port 5435 is reserved for the disposable test service.
#
# DEBUG=True
# DORMIFY_LOCAL_DB_ONLY=True
# DB_NAME=dormify_test
# DB_USER=dormify_user
# DB_PASSWORD=dormify_password
# DB_HOST=localhost
# DB_PORT=5435
# DB_SSLMODE=disable

# ============================================================
# Docker Compose test-service interpolation overrides
# ============================================================
# Compose reads these only when deliberately uncommented in the real `.env`.
# Defaults already match the `.env.test` recipe above. Changing the host port
# away from 5435 makes the deterministic allocation safety check refuse to run.
# TEST_DB_HOST_PORT=5435
# TEST_DB_USER=dormify_user
# TEST_DB_PASSWORD=dormify_password
